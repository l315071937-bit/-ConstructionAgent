# ===== ConstructionAgent V0.1 配置 ======
SECRET_KEY=dev-secret-change-me
JWT_EXPIRE_SECONDS=86400

DATABASE_URL=postgresql+psycopg2://ca:ca@localhost:5432/constructionagent
REDIS_URL=redis://localhost:6379/0

MILVUS_URI=http://localhost:19530

STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# Embedding：api=OpenAI 兼容接口（如 SiliconFlow 的 BAAI/bge-m3）；
# local=本地 sentence-transformers（需安装 sentence-transformers，首次加载约 90s）
# 注意：DeepSeek 无 Embedding API，配 DeepSeek 密钥时用 local 模式
EMBEDDING_MODE=local
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_MODEL=BAAI/bge-m3

# LLM（DeepSeek/Qwen 等 OpenAI 兼容接口）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2

# 检索置信度规则阈值（V0.1 规则版，后续由 evaluation/ 实验校准）
# Milvus COSINE 度量下 0.3~0.4 已是正常相关水平
RETRIEVAL_CONFIDENCE_THRESHOLD=0.25
